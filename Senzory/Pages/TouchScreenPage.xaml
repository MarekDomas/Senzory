<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Senzory.Pages.TouchScreenPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Obrazovka">
    <AbsoluteLayout x:Name="MainLayout">
        <Rectangle
            x:Name="boxView"
            AbsoluteLayout.LayoutBounds="0,0,50,50"
            AbsoluteLayout.LayoutFlags="None"
            Fill="Red" />
        <Label
            x:Name="lbl"
            AbsoluteLayout.LayoutBounds="0.5,0.01,400,80"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            FontAttributes="Bold"
            FontSize="20"
            Text="Táhněte se čtvercem" />
    </AbsoluteLayout>
</ContentPage>